+    (repo / "log").mkdir(parents=True)
+    kit.mkdir()
+    (kit / "gates.txt").write_text("")
+    (kit / "INDEX.md").write_text(
+        "| P0007 | CP0 | P0 | P0006, E0001 | CP0 | — |\n"
+        "| P0008 | Next task | P1 | P0007 | CP0 | — |\n")
+    (repo / "log/CODEX_LOG.md").write_text("")
+    (repo / "log/STATUS.md").write_text(
+        "| Task | Status | Branch/SHA | Tests | Blocker | Reviewer/date | Next |\n"
+        "|---|---|---|---|---|---|---|\n"
+        "| P0006 | Accepted | synthetic-p6 | — | — | synthetic reviewer | — |\n"
+        "| P0007 | Pending | — | — | — | — | — |\n"
+        "| P0008 | Pending | — | — | — | — | — |\n"
+        "| E0001 | Accepted | synthetic-e1 | — | — | synthetic reviewer | — |\n"
+        "| M0001 | Pending | — | — | — | — | — |\n")
+    args = SimpleNamespace(repo=repo, kit=kit, retries=1, timeout=1,
+                           codex_args="--full-auto", verify_cmd="", no_review=False)
+    return orch.Ctx(args)
+
