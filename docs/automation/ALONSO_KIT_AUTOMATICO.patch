+def fake_execution(monkeypatch, ctx, reviewer_rc=0, reviewer_stdout="VERDICT: ACCEPTED\n",
+                   implementation_rc=0, errors=None):
+    calls, resets = [], []
+    monkeypatch.setattr(ctx, "head", lambda: SOURCE_SHA)
+    monkeypatch.setattr(ctx, "dirty", lambda: "")
+    monkeypatch.setattr(ctx, "commit_state", lambda message: calls.append(("commit", message)))
+    monkeypatch.setattr(orch, "sh", lambda *args: SimpleNamespace(returncode=0, stdout="", stderr=""))
+    monkeypatch.setattr(orch, "mechanical_checks", lambda *args: errors or [])
+    monkeypatch.setattr(orch, "reset", lambda *args: resets.append(args[1]))
+    def codex(c, prompt, outfile):
+        if "-impl" in outfile.name:
+            calls.append(("implementation", outfile.name))
+            return implementation_rc, "synthetic implementation"
+        calls.append(("review", outfile.name))
+        return reviewer_rc, reviewer_stdout
+    monkeypatch.setattr(orch, "codex", codex)
+    return calls, resets
+
+
