+@pytest.mark.parametrize("stdout", ["VERDICT: ACCEPTED", "evidence\nVERDICT: ACCEPTED\n"])
+def test_exact_successful_review_advances_to_p0008(monkeypatch, ctx, stdout):
+    calls, resets = fake_execution(monkeypatch, ctx, reviewer_stdout=stdout)
+    assert orch.run_task(ctx, "P0007") == "ok"
+    assert ctx.statuses()["P0007"] == "Accepted"
+    assert "P0008" in ctx.ready()
+    row = next(line for line in ctx.status.read_text().splitlines() if line.startswith("| P0007 |"))
+    assert SOURCE_SHA in row and "Codex (automatic)" in row
+    assert "automatic Codex review" in ctx.log.read_text() and SOURCE_SHA in ctx.log.read_text()
+    assert not resets and [name for name, _ in calls].count("review") == 1
+
