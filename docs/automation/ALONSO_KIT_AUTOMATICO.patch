+@pytest.mark.parametrize("rc,stdout", [
+    (1, "VERDICT: ACCEPTED\n"), (124, "VERDICT: ACCEPTED\n"), (0, ""),
+    (0, "VERDICT: ACCEPTED\nextra text\n"), (0, "VERDICT: ACCEPTED\n\n"),
+    (0, " VERDICT: ACCEPTED\n"), (0, "VERDICT: ACCEPTED \n"),
+    (0, "VERDICT: ACCEPTED-but-incomplete\n"),
+    (0, "VERDICT: CHANGES: broken fixture\n"),
+])
+def test_invalid_review_blocks_acceptance_and_successor(monkeypatch, ctx, rc, stdout):
+    _, resets = fake_execution(monkeypatch, ctx, reviewer_rc=rc, reviewer_stdout=stdout)
+    assert orch.run_task(ctx, "P0007") == "blocked"
+    assert ctx.statuses()["P0007"] == "Blocked" and "P0008" not in ctx.ready()
+    assert resets == [SOURCE_SHA]
